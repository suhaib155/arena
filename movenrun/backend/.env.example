PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/movenrun

# Redis
REDIS_URL=redis://localhost:6379

# Oracle signing key (private key for the trusted oracle)
ORACLE_PRIVATE_KEY=0x...

# Base chain
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Contract addresses (fill after deployment)
MOVE_TOKEN_ADDRESS=0x...
ZONE_NFT_ADDRESS=0x...
GEAR_NFT_ADDRESS=0x...
ZONE_CHALLENGE_ADDRESS=0x...
SEASON_CONTROLLER_ADDRESS=0x...

# Anthropic (for anomaly detection assistance)
ANTHROPIC_API_KEY=sk-ant-...

# H3
H3_RESOLUTION=8

# Wallet-signature auth (see backend/src/middleware/auth.ts) — how long a
# signed request stays valid after its issuedAt timestamp.
AUTH_MAX_AGE_SECONDS=300

# CORS allowlist (see backend/src/middleware/security.ts), comma-separated.
# In development/test, an unset value falls back to common local dev origins.
# In PRODUCTION this MUST be set to an explicit allowlist — an unset value,
# or a value containing a literal "*", makes the backend fail to start
# (fail closed). Never use "*" in production.
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000

# Rate limiting (see backend/src/middleware/rateLimit.ts). RATE_LIMIT_MAX is
# the app-wide limit per RATE_LIMIT_WINDOW_MS; RATE_LIMIT_WRITE_MAX is the
# stricter per-write-endpoint limit over the same window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=20

# ---------------------------------------------------------------------------
# Territory capture (see backend/src/territory/config.ts).
#
# Every value below is validated at startup. An unparseable or out-of-range
# value fails the boot with every problem listed — it never falls back to a
# default silently, because the failure mode of a mistyped threshold is either
# handing out territory for a walk to the corner shop or refusing every valid
# run, with no signal that anything is wrong.
#
# H3_RESOLUTION above is the LEGACY grid (resolution 8) used by the deployed
# contracts and the oracle route proof. It is unrelated to the values here and
# must not be changed to match them.
# ---------------------------------------------------------------------------

# The versioned territory-ownership grid. Version 1 is reserved for the legacy
# resolution-8 route-proof grid and is rejected here.
TERRITORY_GRID_VERSION=2
TERRITORY_H3_RESOLUTION=9

# Closed-loop validity. Closing a loop is necessary but never sufficient — a
# route must satisfy all of these before it can capture anything.
TERRITORY_MIN_ROUTE_POINTS=40
TERRITORY_MIN_ROUTE_DISTANCE_METERS=800
TERRITORY_MIN_DURATION_SECONDS=300
TERRITORY_MAX_CLOSURE_DISTANCE_METERS=50
TERRITORY_MIN_AREA_SQUARE_METERS=10000
TERRITORY_MAX_AREA_SQUARE_METERS=5000000

# GPS quality and physics. MAX_POOR_ACCURACY_RATIO is the share of points
# allowed to exceed MAX_GPS_ACCURACY_METERS before the route is rejected.
TERRITORY_MAX_GPS_ACCURACY_METERS=30
TERRITORY_MAX_POOR_ACCURACY_RATIO=0.3
TERRITORY_MAX_SPEED_METERS_PER_SECOND=8
TERRITORY_MAX_JUMP_METERS=250

# Map API limits. VIEWPORT_AREA is in square degrees — the default is roughly a
# large city. Both caps exist so an unbounded bounding box cannot ask the API to
# serialise every territory on the planet into one response.
TERRITORY_MAX_MAP_VIEWPORT_AREA=0.0625
TERRITORY_MAX_MAP_FEATURES=2000
