# ── Deployer ─────────────────────────────────────────────────────────────────
# Private key of the wallet that will deploy (must hold Base Sepolia ETH)
# Faucet: https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
DEPLOYER_PRIVATE_KEY=0x...

# ── Operator addresses ────────────────────────────────────────────────────────
# EOA that signs GPS routes off-chain (backend oracle service)
ORACLE_ADDRESS=0x...

# Admin address that receives DEFAULT_ADMIN_ROLE on all contracts
ADMIN_ADDRESS=0x...

# Treasury address for SeasonController greatBurn
TREASURY_ADDRESS=0x...

# ── RPC URLs ──────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# ── Basescan API key (for contract verification) ──────────────────────────────
# Get one at: https://basescan.org/apis
BASESCAN_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# MovenRun V3 onchain core — Base Sepolia only
# ═════════════════════════════════════════════════════════════════════════════
# Never commit real values. Every address below must be a distinct account: the
# deploy script refuses a configuration that reuses critical roles, and it never
# accepts settlement signer == reconciliation signer under any circumstances.

# Delayed administrator. Expect a multisignature. Becomes the timelock's sole
# proposer and executor. Must not be the deployer address.
MOVENRUN_ADMIN_ADDRESS=0x...

# Emergency address. May pause new settlement publication, new deed claims and
# new contest declarations. Cannot mint, move player funds, seize deeds, block
# reward claims or block settlement of an active contest.
MOVENRUN_GUARDIAN_ADDRESS=0x...

# Signs daily settlement authorizations.
MOVENRUN_SETTLEMENT_SIGNER=0x...

# Independently approves the same settlement hash before publication and funding.
MOVENRUN_RECONCILIATION_SIGNER=0x...

# Signs deed eligibility attestations.
MOVENRUN_DEED_SIGNER=0x...

# Signs contest declaration and contest-scoped daily score authorizations.
MOVENRUN_CONTEST_SCORE_SIGNER=0x...

# Timelock delay in seconds. Must be nonzero.
MOVENRUN_TIMELOCK_DELAY_SECONDS=172800

# Optional. Current-holder home advantage in basis points, 500 to 1000. Default 500.
MOVENRUN_HOME_ADVANTAGE_BPS=500

# Optional. Rules version new authorizations must declare. Default 1.
MOVENRUN_RULES_VERSION=1

# Optional. Set to true only to deliberately accept a reduced testnet role model
# where some non-critical roles share an address. Settlement signer and
# reconciliation signer are never allowed to be the same address.
# MOVENRUN_ALLOW_ROLE_REUSE=false
