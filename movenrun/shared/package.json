{
  "name": "@movenrun/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./h3": "./src/domain/h3.ts",
    "./session": "./src/domain/session.ts",
    "./geo": "./src/domain/geo.ts",
    "./measurement": "./src/domain/measurement.ts",
    "./sealing": "./src/domain/sealing.ts",
    "./evidence": "./src/domain/evidence.ts",
    "./economy-v3": "./src/domain/economyV3.ts",
    "./holding": "./src/domain/holding.ts",
    "./holdingLedger": "./src/domain/holdingLedger.ts",
    "./holdingSettlement": "./src/domain/holdingSettlement.ts",
    "./clubsDistricts": "./src/domain/clubsDistricts.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "test": "node --import tsx --test src/**/__tests__/*.test.ts",
    "sim": "node --import tsx src/sim/cli.ts",
    "sim:g5": "node --import tsx src/sim/economyG5Cli.ts",
    "sim:ring": "node --import tsx src/sim/deedRingCli.ts",
    "proofs:g5": "bash contract-proofs/g5-ledger/run.sh",
    "proofs:g5:patched": "G5_MODE=patched bash contract-proofs/g5-ledger/run.sh"
  },
  "dependencies": {
    "h3-js": "patch:h3-js@npm%3A4.5.0#~/.yarn/patches/h3-js-npm-4.5.0-64ee667011.patch"
  },
  "devDependencies": {
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  }
}
