{
  "name": "movenrun",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "shared",
    "contracts",
    "backend",
    "mobile"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "verify:contracts": "yarn workspace @movenrun/contracts compile && yarn workspace @movenrun/contracts test",
    "eas-build-pre-install": "corepack enable"
  },
  "packageManager": "yarn@4.9.1",
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "resolutions": {
    "qs": "6.16.0",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.2"
  }
}
