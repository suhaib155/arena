{
  "expo": {
    "name": "MovenRun",
    "slug": "movenrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "movenrun",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6FC",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.movenrun.app"
    },
    "android": {
      "package": "io.movenrun.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MovenRun uses location during a movement session to draw your route and calculate progress."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "73abbcb8-9466-4e52-b912-e2812e170abc"
      }
    }
  }
}
