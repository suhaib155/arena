{
  "expo": {
    "name": "MovenRun",
    "slug": "movenrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "movenrun",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "backgroundColor": "#F8FAF7",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F8FAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.movenrun.app"
    },
    "android": {
      "package": "io.movenrun.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAF7"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MovenRun uses location during a movement session to draw your route and calculate progress."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "73abbcb8-9466-4e52-b912-e2812e170abc"
      }
    }
  }
}
