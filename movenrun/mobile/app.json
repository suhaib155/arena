{
  "expo": {
    "name": "MovenRun",
    "slug": "movenrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "movenrun",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F0E9DE",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0E9DE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.movenrun.app",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "io.movenrun.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4D3A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MovenRun uses your precise location during a territory run to draw your route on the map and work out which zones you crossed.",
          "locationAlwaysAndWhenInUsePermission": "MovenRun keeps recording your route while the app is in the background so a territory run isn't lost when your screen locks. Recording only runs during an active run.",
          "locationAlwaysPermission": "MovenRun keeps recording your route while the app is in the background so a territory run isn't lost when your screen locks. Recording only runs during an active run.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "73abbcb8-9466-4e52-b912-e2812e170abc"
      }
    }
  }
}
