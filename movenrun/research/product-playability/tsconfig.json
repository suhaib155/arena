{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "baseUrl": "../../mobile",
    "paths": {
      "@/*": ["./src/*"],
      "@movenrun/shared": ["../shared/src/index.ts"],
      "@movenrun/shared/*": ["../shared/src/domain/*"]
    }
  },
  "include": ["**/*.ts"]
}
